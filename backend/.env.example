# GitHub API token (required for analyzing repos)
# Generate at: https://github.com/settings/tokens (need: public_repo, read:user)
GITHUB_TOKEN=ghp_your_token_here

# Google Gemini API key (required for gap analysis)
# Get free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Optional: log level
LOG_LEVEL=INFO

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Embedding model (small, ~80MB, CPU-friendly)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Gemini model
GEMINI_MODEL=gemini-flash-lite-latest
